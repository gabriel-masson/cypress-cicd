{
  "name": "cypress-qa-metrics",
  "version": "1.0.0",
  "description": "Mini-projeto de QA automatizado com Cypress, pipeline CI/CD e cálculo de métricas de qualidade",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run --reporter mochawesome --reporter-options reportDir=cypress/reports/mocha,overwrite=false,html=false,json=true",
    "posttest:merge": "mochawesome-merge cypress/reports/mocha/*.json > cypress/reports/mochawesome.json",
    "posttest:html": "marge cypress/reports/mochawesome.json -f report -o cypress/reports",
    "metrics": "node scripts/calculate-metrics.js",
    "test": "npm run cy:run && npm run posttest:merge && npm run posttest:html && npm run metrics"
  },
  "devDependencies": {
    "cypress": "^13.15.0",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.3.0",
    "mochawesome-report-generator": "^6.2.0"
  }
}
